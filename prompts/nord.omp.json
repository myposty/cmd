{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "indigo-dark": "#81A1C1",
    "indigo-mid": "#8FBCBB",
    "indigo-light": "#A3BE8C",
    "violet-muted": "#EBCB8B",
    "indigo": "#B48EAD",
    "amber-muted": "#EBCB8B",
    "danger": "#BF616A",
    "ok": "#A3BE8C",
    "indigo-darkest": "#2E3440",
    "line": "#728eaa",
    "seg-git-dirty": "#ecce91",
    "seg-git-danger": "#e5c0c3",
    "seg-git-ahead": "#d6c1d2",
    "seg-status-error": "#e5c0c3",
    "seg-battery-low": "#e5c0c3",
    "seg-battery-mid": "#ecce91"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:indigo-dark",
          "foreground": "#2E3440",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os",
          "leading_diamond": "",
          "trailing_diamond": ""
        },
        {
          "background": "p:indigo-light",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:seg-git-dirty{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:seg-git-danger{{ end }}",
            "{{ if gt .Ahead 0 }}p:seg-git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:seg-git-ahead{{ end }}"
          ],
          "foreground": "#2E3440",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git",
          "trailing_diamond": ""
        },
        {
          "background": "p:indigo-mid",
          "foreground": "#2E3440",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "...",
            "home_icon": "~"
          },
          "style": "diamond",
          "template": "  {{ .Path }} ",
          "type": "path",
          "trailing_diamond": ""
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:ok",
          "background_templates": [
            "{{ if gt .Code 0 }}p:seg-status-error{{ end }}"
          ],
          "foreground": "#2E3440",
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }} {{ reason .Code }}{{ else }}{{ end }} "
        },
        {
          "type": "sysinfo",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo",
          "foreground": "#2E3440",
          "template": " RAM {{ round .PhysicalPercentUsed 0 }}% "
        },
        {
          "type": "session",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo-mid",
          "foreground": "#2E3440",
          "template": "{{ if .Env.POSH_CPU }} {{ .Env.POSH_CPU_ICON }} {{ .Env.POSH_CPU }}% {{ end }}"
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo-light",
          "foreground": "#2E3440",
          "options": {
            "threshold": 100,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo",
          "foreground": "#2E3440",
          "options": {
            "fetch_version": true
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "battery",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:ok",
          "foreground": "#2E3440",
          "template": "{{ if not .Error }} {{ if eq \"Discharging\" .State.String }}{{ if le .Percentage 15 }}󰂃{{ else }}󰁹{{ end }}{{ else }}󰂄{{ end }} {{ .Percentage }}% {{ end }}",
          "background_templates": [
            "{{ if le .Percentage 30 }}p:seg-battery-low{{ else if le .Percentage 60 }}p:seg-battery-mid{{ end }}"
          ]
        },
        {
          "type": "time",
          "style": "diamond",
          "invert_powerline": true,
          "trailing_diamond": "─╮",
          "background": "p:indigo-dark",
          "foreground": "#2E3440",
          "template": "  {{ .CurrentDate | date \"15:04:05\" }} "
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#728eaa",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "foreground": "#728eaa",
          "style": "plain",
          "template": "─╯",
          "type": "text"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4
}