{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "indigo-dark": "#81A2BE",
    "indigo-mid": "#8ABEB7",
    "indigo-light": "#B5BD68",
    "violet-muted": "#F0C674",
    "indigo": "#AA759F",
    "amber-muted": "#F4BF75",
    "danger": "#AC4142",
    "ok": "#B5BD68",
    "indigo-darkest": "#151515",
    "line": "#728fa7",
    "seg-git-dirty": "#f1c97b",
    "seg-git-danger": "#d6a0a1",
    "seg-git-ahead": "#c49ebc",
    "seg-status-error": "#d6a0a1"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:indigo-dark",
          "foreground": "#151515",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os",
          "leading_diamond": "",
          "trailing_diamond": ""
        },
        {
          "background": "p:indigo-light",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:seg-git-dirty{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:seg-git-danger{{ end }}",
            "{{ if gt .Ahead 0 }}p:seg-git-ahead{{ end }}",
            "{{ if gt .Behind 0 }}p:seg-git-ahead{{ end }}"
          ],
          "foreground": "#151515",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git",
          "trailing_diamond": ""
        },
        {
          "background": "p:indigo-mid",
          "foreground": "#151515",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "...",
            "home_icon": "~"
          },
          "style": "diamond",
          "template": "  {{ .Path }} ",
          "type": "path",
          "trailing_diamond": ""
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:ok",
          "background_templates": [
            "{{ if gt .Code 0 }}p:seg-status-error{{ end }}"
          ],
          "foreground": "#151515",
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }} {{ reason .Code }}{{ else }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo-light",
          "foreground": "#151515",
          "options": {
            "threshold": 100,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo",
          "foreground": "#F0F0F0",
          "options": {
            "fetch_version": true
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "invert_powerline": true,
          "trailing_diamond": "─╮",
          "background": "p:indigo-dark",
          "foreground": "#151515",
          "template": "  {{ .CurrentDate | date \"15:04:05\" }} "
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#728fa7",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "foreground": "#728fa7",
          "style": "plain",
          "template": "─╯",
          "type": "text"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4
}