{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "palette": {
    "indigo-darkest": "#2E2E4A",
    "indigo-dark": "#3B3B5C",
    "indigo-mid": "#4B4B7A",
    "indigo": "#565676",
    "indigo-light": "#6C6C9E",
    "violet-muted": "#7A6C9E",
    "amber-muted": "#8A7A5C",
    "danger": "#9E5C6C",
    "text-light": "#E4E4EF",
    "text-dark": "#1A1A2A",
    "line": "#6C6C9E"
  },
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "background": "p:indigo-dark",
          "foreground": "p:text-light",
          "style": "diamond",
          "template": " {{ if .WSL }}WSL at {{ end }}{{.Icon}} ",
          "type": "os",
          "leading_diamond": "",
          "trailing_diamond": ""
        },
        {
          "background": "p:indigo-light",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}p:violet-muted{{ end }}",
            "{{ if and (gt .Ahead 0) (gt .Behind 0) }}p:danger{{ end }}",
            "{{ if gt .Ahead 0 }}p:indigo{{ end }}",
            "{{ if gt .Behind 0 }}p:indigo{{ end }}"
          ],
          "foreground": "p:text-dark",
          "options": {
            "branch_icon": " ",
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "style": "diamond",
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if and (.Working.Changed) (.Staging.Changed) }} |{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }}{{ if gt .StashCount 0 }}  {{ .StashCount }}{{ end }} ",
          "type": "git",
          "trailing_diamond": ""
        },
        {
          "background": "p:indigo-mid",
          "foreground": "p:text-light",
          "options": {
            "style": "agnoster_short",
            "max_depth": 3,
            "folder_icon": "...",
            "home_icon": "~"
          },
          "style": "diamond",
          "template": "  {{ .Path }} ",
          "type": "path",
          "trailing_diamond": ""
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "right",
      "type": "prompt",
      "segments": [
        {
          "type": "status",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:ok",
          "background_templates": [
            "{{ if gt .Code 0 }}p:danger{{ end }}"
          ],
          "foreground": "p:text-light",
          "options": {
            "always_enabled": true
          },
          "template": " {{ if gt .Code 0 }} {{ reason .Code }}{{ else }}{{ end }} "
        },
        {
          "type": "executiontime",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo-light",
          "foreground": "p:text-light",
          "options": {
            "threshold": 100,
            "style": "austin"
          },
          "template": "  {{ .FormattedMs }} "
        },
        {
          "type": "node",
          "style": "powerline",
          "invert_powerline": true,
          "powerline_symbol": "",
          "background": "p:indigo",
          "foreground": "p:text-light",
          "options": {
            "fetch_version": true
          },
          "template": "  {{ .Full }} "
        },
        {
          "type": "time",
          "style": "diamond",
          "invert_powerline": true,
          "trailing_diamond": "─╮",
          "background": "p:indigo-dark",
          "foreground": "p:text-light",
          "template": "  {{ .CurrentDate | date \"15:04:05\" }} "
        }
      ]
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "p:line",
          "style": "plain",
          "template": "╰─",
          "type": "text"
        }
      ],
      "type": "prompt"
    },
    {
      "segments": [
        {
          "foreground": "p:line",
          "style": "plain",
          "template": "─╯",
          "type": "text"
        }
      ],
      "type": "rprompt"
    }
  ],
  "console_title_template": "{{ .Shell }} in {{ .Folder }}",
  "final_space": true,
  "version": 4
}